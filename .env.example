# Deterministic and key-free. Hosted providers will be explicit alternatives.
AI_PROVIDER=demo
AI_MODEL=demo-v1
AI_TIMEOUT_MS=15000
AI_MAX_OUTPUT_TOKENS=1800

# Required when the Gemini adapter is enabled in a later milestone.
GEMINI_API_KEY=

# Required for authentication and durable persistence.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
