# Use demo for deterministic, key-free local development. Change explicitly to
# gemini only after adding the server-only key and running npm run eval:ai.
AI_PROVIDER=demo
# Empty uses the provider default (gemini-3.5-flash-lite for Gemini).
AI_MODEL=
AI_TIMEOUT_MS=15000
AI_MAX_OUTPUT_TOKENS=1800

# Required only when AI_PROVIDER=gemini. Never prefix this with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Required for authentication and durable persistence.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
