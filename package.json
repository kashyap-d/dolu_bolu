{
  "name": "dolu-bolu",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test": "node --conditions=react-server --import tsx --test 'tests/*.test.ts'",
    "test:watch": "node --conditions=react-server --import tsx --test --watch 'tests/*.test.ts'",
    "eval:ai": "node --conditions=react-server --import tsx scripts/evaluate-ai.ts",
    "test:db": "scripts/with-test-db.sh node --conditions=react-server --import tsx --test --test-concurrency=1 'tests/db/*.test.ts'",
    "db:types": "scripts/with-test-db.sh node --import tsx scripts/generate-db-types.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "postgres": "^3.4.9",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
